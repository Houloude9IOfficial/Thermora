# Thermora configuration. Copy to .env and adjust.

# Thermal limits in degrees Celsius.
THERMORA_CPU_MAX=90
THERMORA_GPU_MAX=90
THERMORA_GLOBAL_MAX=95

# Polling.
THERMORA_POLL_INTERVAL_MS=5000
THERMORA_REQUIRED_SAMPLES=3

# Power action performed when a limit is exceeded: shutdown or restart.
THERMORA_ACTION=shutdown

# Safety switch. true never executes a real shutdown or restart.
THERMORA_DRY_RUN=true

# Optional local API.
THERMORA_API_ENABLED=false
THERMORA_API_HOST=127.0.0.1
THERMORA_API_PORT=8787

# Logging: debug, info, warn or error.
THERMORA_LOG_LEVEL=info

# Optional override for the daemon state file location.
THERMORA_STATE_FILE=

# Optional external sensor providers. Each is disabled while empty. Point one at any CLI
# that prints CPU/GPU temperatures when the operating system exposes none, for example
# macOS:   THERMORA_MACOS_SENSOR_COMMAND=macmon
#          THERMORA_MACOS_SENSOR_ARGS="pipe -s 1"
# Windows: THERMORA_WINDOWS_SENSOR_COMMAND=nvidia-smi.exe
#          THERMORA_WINDOWS_SENSOR_ARGS="--query-gpu=temperature.gpu --format=csv,noheader"
# Linux:   THERMORA_LINUX_SENSOR_COMMAND=sensors
#          THERMORA_LINUX_SENSOR_ARGS="-u"
THERMORA_MACOS_SENSOR_COMMAND=
THERMORA_MACOS_SENSOR_ARGS=
THERMORA_WINDOWS_SENSOR_COMMAND=
THERMORA_WINDOWS_SENSOR_ARGS=
THERMORA_LINUX_SENSOR_COMMAND=
THERMORA_LINUX_SENSOR_ARGS=
