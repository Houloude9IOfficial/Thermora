# Thermora configuration. Copy to .env and adjust.

# Thermal limits in degrees Celsius.
THERMORA_CPU_MAX=90
THERMORA_GPU_MAX=90
THERMORA_GLOBAL_MAX=95

# Polling.
THERMORA_POLL_INTERVAL_MS=5000
THERMORA_REQUIRED_SAMPLES=3

# Power action performed when a limit is exceeded: shutdown or restart.
THERMORA_ACTION=shutdown

# Safety switch. true never executes a real shutdown or restart.
THERMORA_DRY_RUN=true

# Optional local API.
THERMORA_API_ENABLED=false
THERMORA_API_HOST=127.0.0.1
THERMORA_API_PORT=8787

# Logging: debug, info, warn or error.
THERMORA_LOG_LEVEL=info

# Optional override for the daemon state file location.
THERMORA_STATE_FILE=

# macOS only. Opt in to an external CLI that prints CPU/GPU temperatures when macOS
# exposes none, for example smctemp -c, istats scan or osx-cpu-temp. Empty disables it.
THERMORA_MACOS_SENSOR_COMMAND=
THERMORA_MACOS_SENSOR_ARGS=
